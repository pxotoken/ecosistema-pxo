# apps/landing — Vite + React, deployed to Vercel as `ecosistema-pxo-landing`
#
# This app reads exactly ONE env var. Verified 2026-09-02 by grepping
# `import.meta.env.*` across apps/landing/src.
#
# Reminder: VITE_* values are baked into the bundle at build time. Setting
# one in the Vercel dashboard changes nothing until the project is redeployed.

# Base URL of the API the landing page calls.
VITE_API_URL=

# ---------------------------------------------------------------------------
# NOT USED BY THIS APP.
#
# The Vercel production project also carries the eight vars below. None of
# them are referenced anywhere in apps/landing/src — they look copied from
# apps/web. They are inert, which is why landing's testnet-looking config
# (Amoy receiver, testnet token) has no effect on what the page does.
# Delete them from Vercel rather than adding them here. See DEP-009.
#
#   VITE_ENABLE_ADMIN_TESTNET
#   VITE_POLYGON_AMOY_PXO_RECEIVER_ADDRESS
#   VITE_PXO_TOKEN_ADDRESS_TESTNET
#   VITE_SESSION_WARNING_THRESHOLD
#   VITE_SUPABASE_ANON_KEY
#   VITE_SUPABASE_URL
#   VITE_THIRDWEB_AUTH_DOMAIN
#   VITE_THIRDWEB_CLIENT_ID
# ---------------------------------------------------------------------------
