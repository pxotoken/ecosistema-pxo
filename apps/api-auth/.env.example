# Server
PORT=3002
HOST=0.0.0.0
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Thirdweb
VITE_THIRDWEB_CLIENT_ID=
VITE_THIRDWEB_AUTH_DOMAIN=
THIRDWEB_ADMIN_PRIVATE_KEY=
THIRDWEB_SECRET_KEY=

# JWT
JWT_EXPIRATION_TIME=1800

# CORS — origins allowed (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175

# NEXT_PUBLIC_SUPABASE_ANON_KEY was listed here but never read. This service
# builds its Supabase client with SUPABASE_SECRET_KEY (service role); see
# src/lib/supabase.ts. Removed 2026-09-03 — it only produced false positives
# in the prod env audit.
