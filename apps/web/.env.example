# =============================================================================
# apps/web — Vite + React (deployed to Vercel)
# =============================================================================
# All VITE_* vars are baked into the bundle at build time.
# Vercel reads its own values from the dashboard — keep this file in sync
# with `vercel env pull` output to catch drift.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Legacy aliases — read as fallbacks via `import.meta.env.NEXT_PUBLIC_*`.
# New code should use VITE_*. Keep these set ONLY if some component still
# references the NEXT_PUBLIC_ name (search src/components/EnvStatus.tsx,
# src/components/kyc/KycDetailsModal.tsx).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Thirdweb ----------------------------------------------------------------
VITE_THIRDWEB_CLIENT_ID=
VITE_THIRDWEB_AUTH_DOMAIN=
# Legacy fallbacks (same situation as Supabase above)
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=
NEXT_PUBLIC_THIRDWEB_AUTH_DOMAIN=

# --- Chain selection ---------------------------------------------------------
# PROD → mainnet chains, anything else → testnet.
VITE_CHAINS_ENVIRONMENT=PROD
# Default chain new in-app (social/email) wallet sessions land on.
# 137 = Polygon mainnet, 80002 = Polygon Amoy testnet.
# Falls back to 80002 when unset so dev/F&F environments don't accidentally
# provision on mainnet. See SL-011 in BACKLOG.md for the full guard.
VITE_DEFAULT_CHAIN_ID=80002
# When true, forces Polygon mainnet as the active chain.
VITE_FORCE_POLYGON_MAINNET=false
# Admin-only flag to surface testnet UIs in production builds.
VITE_ENABLE_ADMIN_TESTNET=false

# --- PXO token addresses (per chain) -----------------------------------------
VITE_PXO_TOKEN_ADDRESS_MAINNET=
VITE_PXO_TOKEN_ADDRESS_TESTNET=

# --- PXO receiver addresses (treasury) ---------------------------------------
VITE_POLYGON_PXO_RECEIVER_ADDRESS=
VITE_POLYGON_AMOY_PXO_RECEIVER_ADDRESS=
VITE_BSC_PXO_RECEIVER_ADDRESS=

# --- API base URL ------------------------------------------------------------
# Empty → use relative URLs (proxied by vite dev server or Vercel rewrites).
# Set to the orchestrator URL when calling APIs cross-origin.
VITE_API_URL=

# --- Session / auth timing ---------------------------------------------------
# Seconds before JWT expiration that the renewal modal shows up.
VITE_SESSION_WARNING_THRESHOLD=120
# Total JWT lifetime in seconds (must match api-auth JWT_EXPIRATION_TIME).
VITE_JWT_EXPIRATION_TIME=1800
# Seconds before signature requests time out.
VITE_SIGNATURE_TIMEOUT_SECONDS=120
# Auto-renew JWT on user activity. Default true; set "false" to disable.
VITE_AUTO_RENEW_ON_ACTIVITY=true
