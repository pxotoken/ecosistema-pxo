# Habilita los datos dummy/mock en la UI cuando esta en 'true'.
# Si esta en 'false' o sin definir, la app arranca con saldo 0 y listas vacias.
VITE_MOCK_DATA=true

# Payments backend (orchestrator default on :3003; point to :3001 to hit
# api-pagos directly, bypassing the gateway).
VITE_PAYMENTS_API_URL=http://localhost:3003

# POS mode — when true, shows the "Cobrar" screen so the same app can simulate
# a POS Blokko terminal. Leave empty/false to run only in wallet (client) mode.
VITE_POS_MODE_ENABLED=false

# POS credentials (only read when POS mode is on). Must match a row in the
# merchants / pos_devices tables. Generate with apps/api-pagos/scripts/seed-demo.mjs.
VITE_POS_API_KEY=
VITE_POS_MERCHANT_ID=
VITE_POS_POS_ID=
