# apps/pagos — Vite + React (merchant POS), deployed to Vercel as
# `ecosistema-pxo-pagos`
#
# Every var below is referenced via `import.meta.env.*` in apps/pagos/src.
# Verified 2026-09-02.
#
# Reminder: VITE_* values are baked into the bundle at build time. Setting
# one in the Vercel dashboard changes nothing until the project is redeployed.

# --- API ---
VITE_PAYMENTS_API_URL=
VITE_PAYMENTS_CHAIN_ID=137

# --- thirdweb ---
VITE_THIRDWEB_CLIENT_ID=
VITE_THIRDWEB_AUTH_DOMAIN=

# --- session / signing ---
VITE_JWT_EXPIRATION_TIME=
# NOT set on Vercel production as of the 2026-09-02 audit, though the code
# reads it. Confirm the code default is what production should use.
VITE_SIGNATURE_TIMEOUT_SECONDS=

# --- POS terminal identity ---
VITE_POS_MODE_ENABLED=false
VITE_POS_API_KEY=
VITE_POS_MERCHANT_ID=
VITE_POS_POS_ID=

# --- token addresses ---
VITE_PXO_TOKEN_ADDRESS_MAINNET=0xd6f9c21A585E2D77b62Ec8C65ab9beC70e2b77d7
VITE_PXO_TOKEN_ADDRESS_TESTNET=0xeda62cd0d29e077b98e0b61d905c4af906d8946c
# BSC is out of scope per the chain decision (Polygon only for this phase).
# The code still reads this; it is NOT set on Vercel production. Remove the
# code reference rather than setting the var.
VITE_PXO_TOKEN_ADDRESS_BSC=

# --- demo ---
# Must be false in production. Leave unset or false unless demoing.
VITE_MOCK_DATA=false
