# Server
PORT=3004
HOST=::
NODE_ENV=development

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@pxotoken.com
RESEND_FROM_NAME=PXO Platform
RESEND_REPLY_TO=info@pxotoken.com

# Mailbox that receives landing-page contact messages. Defaults to
# info@pxotoken.com; set it only to route contact mail somewhere else.
# Independent of RESEND_REPLY_TO on purpose -- see src/config/env.ts.
CONTACT_INBOX_EMAIL=info@pxotoken.com

# Supabase (needed for broadcast-to-all-users)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Asset base URL used inside email templates
VERCEL_URL=
