# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Thirdweb Configuration
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_thirdweb_client_id_here
THIRDWEB_ADMIN_PRIVATE_KEY=your_thirdweb_admin_private_key_here
NEXT_PUBLIC_THIRDWEB_AUTH_DOMAIN=your_thirdweb_auth_domain_here
THIRDWEB_SECRET_KEY=your_thirdweb_secret_key_here

# Alchemy Configuration
ALCHEMY_API_KEY=your_alchemy_api_key_here

# JWT Configuration
JWT_EXPIRATION_TIME=1800
VITE_JWT_EXPIRATION_TIME=1800

# External wallet signature UX (buy/sell/exchange/send): countdown; single attempt (no auto-retry — avoids duplicate wallet prompts / txs)
VITE_SIGNATURE_TIMEOUT_SECONDS=120

# Session Management Configuration
VITE_SESSION_WARNING_THRESHOLD=20
VITE_AUTO_RENEW_ON_ACTIVITY=true
VITE_SESSION_IDLE_TIMEOUT=60000

# Network Configuration
FORCE_POLYGON_MAINNET=false

# Wallet Encryption Configuration (Optional - for enhanced security)
# If you encrypt keys externally using your encryption service, provide both variables below.
# Alternatively, you can use WALLET_PRIVATE_KEY in plain text (not recommended for production).
ENCRYPTER_PRIVATE_KEY=your_encrypter_master_key_from_external_service
WALLET_PRIVATE_KEY_ENCRYPTED=your_encrypted_wallet_private_key_from_external_service


# Resend Configuration (Email Service)
RESEND_API_KEY=your_resend_api_key_here
# Email address to send from (must be from your verified domain)
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Name that appears as sender
RESEND_FROM_NAME=Your Platform Name
# Email address where replies will be sent (where contact form messages arrive)
RESEND_REPLY_TO=info@yourdomain.com

# Binance API Configuration
# Use production: https://api.binance.com/api/v3
# Use testnet: https://testnet.binance.vision/api/v3
BINANCE_API_BASE_URL=https://api.binance.com/api/v3
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Cron Job Security
# Secret token to protect cron job endpoints
# Generate a secure token: openssl rand -base64 32
CRON_SECRET=your_secure_random_token_here
