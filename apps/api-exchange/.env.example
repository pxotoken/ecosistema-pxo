# Server
PORT=3008
HOST=0.0.0.0
NODE_ENV=development

# CORS — who can hit this service directly (orchestrator + vite dev servers)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3003

# Supabase (pricing_rules, tokens)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Thirdweb — treasury wallet balances for liquidity endpoint
VITE_THIRDWEB_CLIENT_ID=
THIRDWEB_SECRET_KEY=

# Treasury wallet key (encrypted preferred; plain supported as fallback)
WALLET_PRIVATE_KEY_ENCRYPTED=
ENCRYPTER_PRIVATE_KEY=
# WALLET_PRIVATE_KEY=

# Token addresses per chain
PXO_TOKEN_ADDRESS_MAINNET=
PXO_TOKEN_ADDRESS_TESTNET=

# Force polygon mainnet as primary chain (default: false → amoy)
FORCE_POLYGON_MAINNET=false

# Pair pricing source: 'binance' (default) or 'bitso'
PRICE_PROVIDER=binance

# Binance — used by pricing service when PRICE_PROVIDER=binance (public ticker, no auth)
BINANCE_API_BASE_URL=https://api.binance.com/api/v3

# Bitso PUBLIC ticker — used by pricing service when PRICE_PROVIDER=bitso (no auth;
# distinct from the authenticated Business API BITSO_API_BASE_URL below)
BITSO_TICKER_BASE_URL=https://api.bitso.com/v3
# Bitso has no USDC market, so USDC is priced off USDT. Set true to correct the
# USDC/USDT leg with a live rate from Binance; false assumes USDC == USDT (1:1).
BITSO_USDC_CORRECTION_ENABLED=false

# Conekta — fiat pay-in funnel for MXN → PXO on-ramp
CONEKTA_API_BASE_URL=https://api.conekta.io
CONEKTA_PRIVATE_KEY=
CONEKTA_WEBHOOK_SECRET=
CONEKTA_SUCCESS_URL=http://localhost:5173/dashboard/fiat?status=success
CONEKTA_FAILURE_URL=http://localhost:5173/dashboard/fiat?status=failure

# Bitso Business (stage) — fiat custodian + SPEI rail
BITSO_API_BASE_URL=https://stage.bitso.com/api/v3
BITSO_API_KEY=
BITSO_API_SECRET=
# Bitso v4 webhooks sign with RSA — there is no shared secret to set.
# Stage: https://stage.bitso.com/v4   Prod: https://api.bitso.com/v4
BITSO_WEBHOOK_API_BASE_URL=https://stage.bitso.com/v4
# Bitso egress IPs. Leave empty on stage/local to disable the check.
# Prod: 52.15.91.227,18.216.72.107,18.219.140.132
BITSO_WEBHOOK_IP_ALLOWLIST=

# Demo flag — true skips polling Bitso for pay-in confirmation
# Production MUST set this to false. Trusts Conekta webhook directly.
FIAT_DEMO_SKIP_BITSO_FUNDING_CHECK=true

# QA-only self-serve tool to simulate MXN SPEI deposits via Bitso's stage
# `/spei/test/deposits` endpoint. NEVER set to true in production. The route
# /api/exchange/qa/mock-bitso-deposit is registered ONLY when this is true.
# The frontend also needs VITE_MOCK_DEPOSITS_ENABLED=true to show the page.
MOCK_DEPOSITS_ENABLED=false

# --- Receiver addresses (treasury) — read by chain registry ------------------
POLYGON_PXO_RECEIVER_ADDRESS=
POLYGON_AMOY_PXO_RECEIVER_ADDRESS=
BSC_PXO_RECEIVER_ADDRESS=

# --- Default tokens per chain (used when no specific token requested) --------
POLYGON_DEFAULT_TOKEN=
POLYGON_AMOY_DEFAULT_TOKEN=
BSC_DEFAULT_TOKEN=

# — the 18-digit CLABE of your Bitso Business account (destination for user SPEI)
BITSO_BUSINESS_CLABE=710969000000566250
#  — display name (default "PXO Treasury MX")
BITSO_BUSINESS_BENEFICIARY_NAME=PXO Treasury MX
# — optional, default 24
DEPOSIT_INTENT_TTL_HOURS=24
#  — optional, default 30000 (30s)
DEPOSIT_MATCH_WORKER_INTERVAL_MS=3000
# — optional; set to false to disable the worker (dev/debug)
DEPOSIT_MATCH_WORKER_ENABLED=true



# --- Gas subsidy guardrails (rate-limit + daily cap) -------------------------
GAS_SUBSIDY_MIN_INTERVAL_MINUTES=
MAX_GAS_SUBSIDIES_PER_DAY=
MAX_GAS_SUBSIDY_DAILY_AMOUNT_WEI=
