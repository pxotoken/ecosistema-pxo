# Server
PORT=3008
HOST=0.0.0.0
NODE_ENV=development

# CORS — who can hit this service directly (orchestrator + vite dev servers)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3003

# Supabase (pricing_rules, tokens)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Thirdweb — treasury wallet balances for liquidity endpoint
VITE_THIRDWEB_CLIENT_ID=
THIRDWEB_SECRET_KEY=

# Treasury wallet key (encrypted preferred; plain supported as fallback)
WALLET_PRIVATE_KEY_ENCRYPTED=
ENCRYPTER_PRIVATE_KEY=
# WALLET_PRIVATE_KEY=

# Token addresses per chain
PXO_TOKEN_ADDRESS_MAINNET=
PXO_TOKEN_ADDRESS_TESTNET=

# Force polygon mainnet as primary chain (default: false → amoy)
FORCE_POLYGON_MAINNET=false

# Binance — used by pricing service (public ticker, no auth required)
BINANCE_API_BASE_URL=https://api.binance.com/api/v3

# Conekta — fiat pay-in funnel for MXN → PXO on-ramp
CONEKTA_API_BASE_URL=https://api.conekta.io
CONEKTA_PRIVATE_KEY=
CONEKTA_WEBHOOK_SECRET=
CONEKTA_SUCCESS_URL=http://localhost:5173/dashboard/fiat?status=success
CONEKTA_FAILURE_URL=http://localhost:5173/dashboard/fiat?status=failure

# Bitso Business (stage) — fiat custodian + SPEI rail
BITSO_API_BASE_URL=https://stage.bitso.com/api/v3
BITSO_API_KEY=
BITSO_API_SECRET=
BITSO_WEBHOOK_SECRET=

# Demo flag — true skips polling Bitso for pay-in confirmation
# Production MUST set this to false. Trusts Conekta webhook directly.
FIAT_DEMO_SKIP_BITSO_FUNDING_CHECK=true
