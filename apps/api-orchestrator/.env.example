# Server
PORT=3003
HOST=0.0.0.0
NODE_ENV=development

# Upstreams — servicios de dominio a los que el orquestador rutea
UPSTREAM_API_AUTH=http://localhost:3002
UPSTREAM_API_EMAIL=http://localhost:3004
UPSTREAM_API_PAGOS=http://localhost:3001
UPSTREAM_API_USERS=http://localhost:3005
UPSTREAM_API_KYC=http://localhost:3006
UPSTREAM_API_WALLET=http://localhost:3007
UPSTREAM_API_EXCHANGE=http://localhost:3008
UPSTREAM_API_LEGACY=http://localhost:3000

# CORS — orígenes permitidos (coma-separados)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# JWT verify (mismo set que api-auth — fuente única de verdad)
VITE_THIRDWEB_CLIENT_ID=
VITE_THIRDWEB_AUTH_DOMAIN=
THIRDWEB_ADMIN_PRIVATE_KEY=
JWT_EXPIRATION_TIME=1800

# --- Undocumented in prod until the 2026-09-02 audit (DEP-009) -------------
# NOT a Next.js leftover on the backend: api-auth and api-email read this
# exact name as their SUPABASE_URL (api-auth/src/config/env.ts:6,
# api-email/src/config/env.ts:17). Node reads process.env with no prefix
# filtering, so the NEXT_PUBLIC_ name is load-bearing here. Removing it breaks
# authentication and email.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
