# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Pedir al admin del proyecto Supabase: necesaria para que el backend opere saltando RLS.
SUPABASE_SECRET_KEY=

# Thirdweb
VITE_THIRDWEB_CLIENT_ID=
VITE_THIRDWEB_AUTH_DOMAIN=
THIRDWEB_ADMIN_PRIVATE_KEY=

# Polygon Amoy / PXO Token
POLYGON_AMOY_PXO_RECEIVER_ADDRESS=
VITE_POLYGON_AMOY_PXO_RECEIVER_ADDRESS=
PXO_TOKEN_ADDRESS_TESTNET=
VITE_PXO_TOKEN_ADDRESS_TESTNET=
VITE_ENABLE_ADMIN_TESTNET=false
ALCHEMY_API_KEY=

# Wallet
WALLET_PRIVATE_KEY_ENCRYPTED=

# Binance (price oracle)
# Production: https://api.binance.com/api/v3
# Testnet:    https://testnet.binance.vision/api/v3
BINANCE_API_KEY=
BINANCE_API_BASE_URL=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
RESEND_REPLY_TO=

# Upstash Redis (rate limit / cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron Job Security
# Generate: openssl rand -base64 32
CRON_SECRET=

# Session
VITE_SESSION_WARNING_THRESHOLD=120

# --- Multi-chain payments support --------------------------------------------
# Active chain for incoming payments. 137=Polygon, 80002=Amoy, 56=BSC.
PAYMENTS_CHAIN_ID=80002
PXO_TOKEN_ADDRESS_BSC=
POLYGON_MAINNET_RPC_URL=
BSC_RPC_URL=

# --- Payment lifecycle workers ----------------------------------------------
# How long an unpaid payment intent stays valid before expiring.
PAYMENT_TTL_MINUTES=15
# Poll interval (ms) for the worker that expires stale payments.
EXPIRATION_WORKER_INTERVAL_MS=60000
# Poll interval (ms) for the on-chain reconciliation worker.
RECONCILIATION_WORKER_INTERVAL_MS=30000

# --- Webhook signing secrets -------------------------------------------------
# Inbound: validates webhooks we receive (e.g. from POS terminals).
# Outbound: signs webhooks we send to merchants.
WEBHOOK_INBOUND_SECRET=
WEBHOOK_OUTBOUND_SECRET=
